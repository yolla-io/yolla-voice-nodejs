{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "paths": { "@yolla-io/yolla-voice-nodejs": ["./src/index.ts"] },
    "outDir": "dist"
  },
  "include": ["src/**/*", "test/**/*", "examples/**/*", "vitest.config.ts"]
}
